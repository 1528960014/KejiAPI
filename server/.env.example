# ModelHub server configuration (copy to .env and adjust)

# Public listen port
PORT=8080

# PostgreSQL (see deploy/docker-compose.yml: modelhub/modelhub on 5432)
DATABASE_URL=postgres://modelhub:modelhub@127.0.0.1:5432/modelhub?sslmode=disable

# Redis (task queue / cache)
REDIS_URL=redis://127.0.0.1:6379/0

# Root admin key for /admin/* — MUST be at least 16 chars, change it!
MASTER_KEY=change-me-to-a-long-random-string

LOG_LEVEL=info

# Where composed drama videos are written/served
MODELHUB_MEDIA_DIR=./media

# --- P4-3: per-key rate limits (optional) -----------------------------------
# Requests per minute / tokens per minute per API key, fixed 1-minute window.
# Leave empty (or 0) to disable. 429 code: rate_limited.
MODELHUB_RPM=
MODELHUB_TPM=

# --- P2-4: online recharge (optional) -------------------------------------
# NOTE (P3-2): the PAY_* values below are only the INITIAL DEFAULT. On first
# start they are seeded into the database; afterwards the runtime source of
# truth is the admin console API (GET/PUT /admin/pay-config, hot reload, no
# restart). Changing env on an existing deployment has no effect until the
# pay_settings row is deleted.
#
# CNY per 1 USD for balance top-up (e.g. 7.2). Leave empty to disable
# online recharge entirely.
PAY_CNY_PER_USD=
# Externally reachable base URL used in payment notify/return URLs
# (your public domain; omit to derive from the request Host).
PAY_PUBLIC_URL=

# Channel 1: 易支付 (open-source YiPay mapi) — all three required.
# MAPI URL = your gateway's mapi endpoint (e.g. https://pay.example.com/mapi.php).
PAY_YIPAY_MAPI_URL=
PAY_YIPAY_PID=
PAY_YIPAY_KEY=

# Channel 2: Alipay official (当面付 precreate; the merchant app must have
# the 当面付 product enabled). PEM values may use literal \n for newlines.
PAY_ALIPAY_APP_ID=
PAY_ALIPAY_PRIVATE_KEY=
PAY_ALIPAY_PUBLIC_KEY=

# Channel 3: WeChat Pay official (v3 native QR).
# MCH_ID: 商户号; API_V3_KEY: 32-char APIv3 key; MERCHANT_SERIAL: 商户API证书序列号;
# PRIVATE_KEY: 商户API证书私钥 (PEM); PLATFORM_KEY: 微信支付平台公钥 (PEM).
# APP_ID is optional for native QR.
PAY_WECHAT_MCH_ID=
PAY_WECHAT_APP_ID=
PAY_WECHAT_API_V3_KEY=
PAY_WECHAT_MERCHANT_SERIAL=
PAY_WECHAT_PRIVATE_KEY=
PAY_WECHAT_PLATFORM_KEY=