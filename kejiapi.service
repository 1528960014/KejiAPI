# File path: /etc/systemd/system/kejiapi.service
# sudo systemctl daemon-reload
# sudo systemctl start kejiapi
# sudo systemctl enable kejiapi
# sudo systemctl status kejiapi
[Unit]
Description=One API Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/kejiapi  # 注意修改路径
ExecStart=/path/to/kejiapi/kejiapi --port 3000 --log-dir /path/to/kejiapi/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
