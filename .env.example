# PostgreSQL DSN used by the server
DATABASE_URL=postgres://modelhub:modelhub@127.0.0.1:5432/modelhub?sslmode=disable
# Optional: Redis for rate limiting / queues (M2+)
REDIS_URL=redis://127.0.0.1:6379/0
# Secret used to call the /admin management API (keys, channels, models)
MASTER_KEY=change-me
# HTTP port
PORT=8080
LOG_LEVEL=info