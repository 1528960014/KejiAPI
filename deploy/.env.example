# Docker deployment environment — copy to deploy/.env and edit.
# (DATABASE_URL / REDIS_URL / PORT / MODELHUB_MEDIA_DIR are set by
#  docker-compose.yml to the in-network service names; do not put host
#  addresses here.)

# Secret for the /admin API and the web admin login. Must be >= 16 chars;
# use 32+ random chars, e.g.: openssl rand -hex 32
MASTER_KEY=change-me-to-32-random-chars

# Public base URL of this deployment (payment notify/return URLs).
PAY_PUBLIC_URL=https://your-domain

# Optional per-key rate limits (0 = disabled).
MODELHUB_RPM=0
MODELHUB_TPM=0

# Online recharge: CNY per 1 USD (0 = recharge disabled even if providers
# below are configured).
PAY_CNY_PER_USD=7.2

# Payment providers — leave blank to disable. Details: docs/api.md
# "Online recharge (P2-4)".
PAY_YIPAY_MAPI_URL=
PAY_YIPAY_PID=
PAY_YIPAY_KEY=
PAY_ALIPAY_APP_ID=
PAY_ALIPAY_PRIVATE_KEY=
PAY_ALIPAY_PUBLIC_KEY=
PAY_WECHAT_MCH_ID=
PAY_WECHAT_APP_ID=
PAY_WECHAT_APIV3_KEY=
PAY_WECHAT_MERCHANT_SERIAL=
PAY_WECHAT_PRIVATE_KEY=
PAY_WECHAT_PLATFORM_KEY=
