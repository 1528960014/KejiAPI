# Compose variant of deploy/nginx.conf: the Go server lives on the compose
# network as the `app` service. Rendered by the official nginx image from
# /etc/nginx/templates/ at container start.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Hash-named SPA bundles: long-lived caching is safe (the name changes
    # with the content). A missing asset MUST 404 - letting it fall back to
    # index.html made browsers execute HTML as a module script after a
    # redeploy, which blanked the whole app (white screen).
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Document + SPA deep links: revalidate on every load so a redeploy's
    # new index.html replaces the cached one.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Exact /admin is the SPA admin console (Vue route); the /admin/ prefix
    # below proxies the admin API to the Go server. Without this exact-match
    # block nginx 301s /admin -> /admin/ which the API 404s.
    location = /admin {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    # /admin/ is the same SPA page (browsers cache the historical 301 from
    # /admin to /admin/); two-segment /admin/<resource> paths fall through to
    # the API proxy below.
    location = /admin/ {
        try_files /index.html =404;
        add_header Cache-Control "no-cache";
    }

    location /v1/ {
        proxy_pass http://app:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /admin/ {
        proxy_pass http://app:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /healthz {
        proxy_pass http://app:8080;
    }
}
