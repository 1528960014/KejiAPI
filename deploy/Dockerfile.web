# syntax=docker/dockerfile:1
# ModelHub web console: Vite SPA built here, served by nginx with the API
# proxied to the `app` service on the compose network (see nginx.docker.template).

FROM node:22-alpine AS build
# Build arg so networks where registry.npmjs.org is slow/blocked can pass
# --build-arg NPM_CONFIG_REGISTRY=https://registry.npmmirror.com (see
# deploy.sh BUILD_ARGS). pnpm >= 11 only reads registry/auth from .npmrc,
# so it is written into the project dir.
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
RUN corepack enable
WORKDIR /build
RUN printf "registry=%s\n" "${NPM_CONFIG_REGISTRY}" > .npmrc
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
RUN pnpm build

FROM nginx:1.27-alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.docker.template /etc/nginx/templates/default.conf.template
